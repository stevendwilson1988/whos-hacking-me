# Copy to /etc/www-traffic/alerts.env (root-owned, mode 600) and fill in.
# systemd reads it via EnvironmentFile= in www-traffic.service. Kept out of git
# because it holds personal email addresses.

# Gmail account the alerts are sent from. Its app password goes in
# /etc/www-traffic/smtp-password (root-only) and reaches the app as a systemd credential.
WHT_ALERT_FROM=sender@gmail.com
# Where alerts are delivered.
WHT_ALERT_TO=you@example.com

# Database size cap in GiB. Past it, the oldest visits are deleted.
WHT_MAX_DB_GB=5
# Free-disk floor in GiB. Below it, the database stops growing.
WHT_MIN_FREE_GB=5
