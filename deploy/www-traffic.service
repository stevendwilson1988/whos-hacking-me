[Unit]
Description=www-traffic log (live visitor table)
After=network.target

[Service]
Type=simple
User=ubuntu
SupplementaryGroups=adm
WorkingDirectory=/opt/www-traffic
ExecStart=/usr/bin/python3 -m gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5002 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
